rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && request.auth.uid == "KMKNZedIqZZ4kx4l3dDCSqMxYCZ2";
    }

    // 公開共享辭典。既有資料仍保留在這個 collection。
    match /research_dictionary/{termId} {
      allow read: if true;

      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid;

      allow update: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isAdmin())
        && request.resource.data.createdBy == resource.data.createdBy;

      allow delete: if signedIn()
        && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // 每位使用者自己的私人辭典。
    match /user_research_dictionary/{uid}/terms/{termId} {
      allow read: if signedIn()
        && request.auth.uid == uid;

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.createdBy == uid;

      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.createdBy == uid
        && request.resource.data.createdBy == uid;

      allow delete: if signedIn()
        && request.auth.uid == uid
        && resource.data.createdBy == uid;
    }

    // 桌面版 Google 登入一次性接力文件。
    // sessionId 為桌面端產生的高強度隨機值；禁止列舉，只允許精確 get。
    match /desktop_login_sessions/{sessionId} {
      allow get: if resource.data.expiresAt is timestamp
        && request.time < resource.data.expiresAt;
      allow list: if false;

      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid;

      allow update: if false;

      allow delete: if signedIn()
        && resource.data.uid == request.auth.uid;
    }
  }
}
