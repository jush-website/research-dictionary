{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Research Dictionary",
  "version": "0.5.4",
  "identifier": "tw.jush.researchdictionary",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Research Dictionary",
        "width": 760,
        "height": 820,
        "minWidth": 520,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "visible": true,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "mainBinaryName": "ResearchDictionary"
}
